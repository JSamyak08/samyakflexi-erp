# Browser (Vite). Both values are required. The app does not fall back to a
# project URL or anon key baked into source. The anon key that used to be
# committed must be rotated in Supabase; put the new key here and in Vercel.
# Example project URL: https://eamstsaqkbeiywfaanhi.supabase.co
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Public site written into auth emails. VITE_PUBLIC_SITE_URL wins, then
# VITE_APP_ORIGIN. A vercel.app or supabase.co value is ignored and the
# link falls back to https://erp.samyakinternational.in. The page origin is
# not used when the browser is on one of those hosts.
VITE_PUBLIC_SITE_URL=https://erp.samyakinternational.in
VITE_APP_ORIGIN=https://erp.samyakinternational.in

# Sentry. Leave the DSN empty to disable reporting. Do not enable session replay.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=production
# Optional. Vercel sets VERCEL_GIT_COMMIT_SHA at build time when this is empty.
VITE_SENTRY_RELEASE=

# Server only. Never prefix the service role or SMTP password with VITE_.
# Mail is refused when any SMTP_* value is missing. SMTP_SECURE must be exactly
# true or false. Port 465 does not turn TLS on by itself, and certificates are verified.
# Same project as VITE_SUPABASE_URL. Example: https://eamstsaqkbeiywfaanhi.supabase.co
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# Password links are built from this origin. A missing value, or a vercel.app
# or supabase.co host, falls back to https://erp.samyakinternational.in.
# The request body is ignored.
PUBLIC_SITE_URL=https://erp.samyakinternational.in
APP_ORIGIN=https://erp.samyakinternational.in
# Manual Send clicks still reroute any non-internal recipient to
# admin@samyakinternational.in. Set this to true only to deliver those manual
# messages to the address the user typed. Automated mail ignores this switch.
# Off unless the value is exactly true.
ALLOW_EXTERNAL_MANUAL_EMAIL=false
